<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PolyCraft</RootNamespace>
    <AssemblyName>PolyCraft</AssemblyName>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon above only embeds the native exe/taskbar icon; WPF's XAML Icon="Icon.ico"
         needs the file separately included as a pack resource to resolve at runtime. -->
    <Resource Include="Icon.ico" />
  </ItemGroup>

</Project>
