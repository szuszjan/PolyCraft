<Window x:Class="PolyCraft.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PolyCraft"
        Icon="Icon.ico"
        Width="680" Height="340"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#FF1A1A1A"
        Opacity="0">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="LogoScaleTransform" ScaleX="0.8" ScaleY="0.8" />
            </StackPanel.RenderTransform>
            <Grid HorizontalAlignment="Center">
                <TextBlock x:Name="LogoBack"
                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                           Foreground="#FF3D2E05"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="7,7,0,0" />
                <TextBlock x:Name="LogoMid"
                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                           Foreground="#FFA9740E"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="4,4,0,0" />
                <TextBlock x:Name="LogoFront"
                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                           Foreground="#FFF4D03F"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="0,0,0,0" />
            </Grid>
            <TextBlock Text="low-poly 3D modeling"
                       FontFamily="Consolas"
                       FontSize="13"
                       Foreground="#FF999999"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
        </StackPanel>
    </Grid>
</Window>
